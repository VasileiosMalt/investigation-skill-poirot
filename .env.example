# ──────────────────────────────────────────────────────────────────────────────
# Poirot Investigation Agent — Environment Configuration Template
# Copy this file to .env and fill in the values you need.
#
# Priority: shell environment > .env file > interactive prompt
# Local / vLLM models work without any API keys — just set POIROT_LOCAL_URL.
# ──────────────────────────────────────────────────────────────────────────────


# ── API Keys (all optional — only needed for the provider you choose) ──────────

# OpenAI (GPT-4o, GPT-4o-mini, Whisper, etc.)
# OPENAI_API_KEY=sk-...

# Anthropic (Claude Opus / Sonnet / Haiku)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (multi-provider gateway — one key for many models)
# OPENROUTER_API_KEY=sk-or-...

# Google AI Studio (Gemini 2.5 Pro / Flash — native video support)
# GOOGLE_API_KEY=AIza...

# Groq (fast inference for Llama, Mistral, etc.)
# GROQ_API_KEY=gsk_...

# Together AI (hosted open-source models)
# TOGETHER_API_KEY=...

# Mistral
# MISTRAL_API_KEY=...


# ── Provider Selection ────────────────────────────────────────────────────────
# Which provider to use by default.
# Options: openai | anthropic | openrouter | google | groq | together | mistral | local
# If not set, Poirot auto-detects from whichever API key is present.
# Falls back to "local" if no keys are found.
# POIROT_PROVIDER=openai


# ── Model Overrides ───────────────────────────────────────────────────────────
# Override the specific models used for each modality.
# Leave commented to use Poirot's built-in defaults.

# Text model for CKB generation, classification, and synthesis
# POIROT_TEXT_MODEL=gpt-4o-mini

# Vision / VLLM model for image analysis (must support vision input)
# POIROT_VISION_MODEL=gpt-4o

# ASR model for audio transcription (Whisper variant or API model)
# POIROT_AUDIO_MODEL=whisper-1


# ── Local / vLLM Server ───────────────────────────────────────────────────────
# Point Poirot at a local inference server (Ollama, vLLM, LM Studio, etc.)
# When POIROT_LOCAL_URL is set, no API key is required.

# Base URL of the local OpenAI-compatible endpoint
# POIROT_LOCAL_URL=http://localhost:11434/v1

# Model name served by the local endpoint (e.g. llava, mistral, llama3)
# POIROT_LOCAL_MODEL=llava


# ── Output ────────────────────────────────────────────────────────────────────
# Default output directory for all phase reports.
# Can also be set with --output-dir on the command line.
# POIROT_OUTPUT_DIR=
